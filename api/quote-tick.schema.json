{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qoder.local/qoder-terminal-data/quote-tick.schema.json",
  "title": "QuoteTick",
  "description": "Real-time quote pushed by qoder-terminal-data over WebSocket /v1/stream",
  "type": "object",
  "required": ["type", "symbol", "price", "asOf"],
  "properties": {
    "type": { "const": "quote_tick" },
    "symbol": { "type": "string" },
    "price": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
    "asOf": { "type": "string", "format": "date-time" }
  }
}
